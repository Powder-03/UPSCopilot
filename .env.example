# ==========================================
# AWS Bedrock API Configuration
# ==========================================
BEDROCK_API_KEY=your_bedrock_api_key_here
AWS_REGION=us-east-1

# ==========================================
# Evaluation Model: Moonshot Kimi 2.5
# ==========================================
BEDROCK_EVAL_MODEL_ID=moonshotai.kimi-k2.5
EVAL_TEMPERATURE=0.2
EVAL_MAX_TOKENS=4096

# ==========================================
# Bedrock Embedding Model
# ==========================================
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# ==========================================
# Knowledge Base Storage
# ==========================================
KB_STORAGE_DIR=src/kb/storage
DATA_DIR=src/kb/data
