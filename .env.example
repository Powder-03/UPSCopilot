# ==========================================
# Primary LLM Provider: 'vertex' or 'bedrock'
# ==========================================
LLM_PROVIDER=vertex

# ==========================================
# Google Cloud Vertex AI Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GCP_PROJECT_ID=project-1b52589d-0827-46ab-9be
GCP_LOCATION=us-central1
VERTEX_EVAL_MODEL_ID=gemini-2.5-flash
VERTEX_VISION_MODEL_ID=gemini-2.5-flash

# ==========================================
# AWS Bedrock API Configuration
# ==========================================
BEDROCK_API_KEY=your_bedrock_api_key_here
AWS_REGION=us-east-1

# ==========================================
# Evaluation & Vision Models: Moonshot Kimi 2.5
# ==========================================
BEDROCK_EVAL_MODEL_ID=moonshotai.kimi-k2.5
BEDROCK_VISION_MODEL_ID=moonshotai.kimi-k2.5
EVAL_TEMPERATURE=0.2
EVAL_MAX_TOKENS=4096

# ==========================================
# Bedrock Embedding Model
# ==========================================
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# ==========================================
# Knowledge Base Storage
# ==========================================
KB_STORAGE_DIR=data/storage
DATA_DIR=data

# ==========================================
# Confident AI / DeepEval Dashboard
# ==========================================
CONFIDENT_API_KEY=your_confident_api_key_here

# ==========================================
# AWS Serverless Deployment (Lambda, S3, DynamoDB, SQS)
# ==========================================
# Leave empty for local development (uses local disk and background threads)
S3_BUCKET=
DYNAMODB_TABLE=
SQS_QUEUE_URL=
