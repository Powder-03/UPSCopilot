# ==============================================================================
# LLM Provider: Google Cloud Vertex AI (Gemini 2.5 Flash)
# ==============================================================================
LLM_PROVIDER=vertex

# Google Cloud Vertex AI Credentials & Models
GEMINI_API_KEY=your_gemini_api_key_here
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=us-central1
VERTEX_EVAL_MODEL_ID=gemini-2.5-flash
VERTEX_VISION_MODEL_ID=gemini-2.5-flash

# Knowledge Base Storage & Pinecone Vector Store
KB_STORAGE_DIR=data/storage
DATA_DIR=data
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=upsc-kb
EMBEDDING_DIMENSION=768

# ==============================================================================
# AWS Cloud Infrastructure (Hosting, S3, DynamoDB, SQS, SES Email)
# ==============================================================================
AWS_REGION=us-east-1

# Email Delivery Configuration (Google SMTP / Gmail, SES, or local mock)
EMAIL_PROVIDER=google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yujitodoyuta@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
MAIL_FROM_NAME="UPSC Evaluator"
MAIL_FROM_EMAIL=yujitodoyuta@gmail.com
# Optional Amazon SES fallback
SES_FROM_EMAIL=yujitodoyuta@gmail.com

# Serverless Infrastructure Resources (Populated after 'sam deploy')
# Leave empty for local development (uses local disk and background threads)
S3_BUCKET=
DYNAMODB_TABLE=
PARSED_BOOKLETS_TABLE=
VISION_QUEUE_URL=
EVAL_QUEUE_URL=

# ==============================================================================
# Confident AI / DeepEval Dashboard (Optional)
# ==============================================================================
CONFIDENT_API_KEY=

# ==============================================================================
# LangSmith Observability & Tracing (Optional)
# ==============================================================================
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=UPSCopilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
