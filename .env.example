# AWS Bedrock Credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
# Optional: AWS_SESSION_TOKEN if using temporary credentials
# AWS_SESSION_TOKEN=

# Bedrock Embedding Model Configuration
# Options: amazon.titan-embed-text-v2:0 (recommended), amazon.titan-embed-text-v1, cohere.embed-english-v3
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# Knowledge Base Storage Path
KB_STORAGE_DIR=src/kb/storage
